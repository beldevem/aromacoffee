      "danger": { "value": "#A43C35", "type": "color" }
    }
  },
  "fontFamily": {
    "display": { "value": "Cormorant Garamond", "type": "fontFamily", "description": "Warm editorial serif for headings and menu category names." },
    "body": { "value": "Source Sans 3", "type": "fontFamily", "description": "Readable sans serif for UI, descriptions, and forms." },
