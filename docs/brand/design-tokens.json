  "name": "Aroma Coffee Shop",
  "description": "Initial design tokens inferred from the supplied Aroma menu and logo artwork. Validate the hex values against the original brand source before production.",
  "color": {
    "brand": {
      "green": { "value": "#50684E", "type": "color" },
      "greenDeep": { "value": "#354A36", "type": "color" },
      "greenSoft": { "value": "#71866C", "type": "color" },
      "cream": { "value": "#E8D7AB", "type": "color" },
      "gold": { "value": "#C9AA70", "type": "color" }
    },
    "neutral": {
      "ink": { "value": "#1E211C", "type": "color" },
      "inkMuted": { "value": "#596057", "type": "color" },
      "ivory": { "value": "#F7F5EF", "type": "color" },
      "paper": { "value": "#FFFEFA", "type": "color" },
      "line": { "value": "#D8D8CC", "type": "color" }
    },
    "semantic": {
      "text": { "value": "{color.neutral.ink}", "type": "color" },
      "textMuted": { "value": "{color.neutral.inkMuted}", "type": "color" },
